# TrustRehearsal Configuration

# Deployment Mode: LOCAL_OPERATOR or PUBLIC_VIEWER
MODE=LOCAL_OPERATOR

# Server
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/trustrehearsal

# Operator Auth (LOCAL_OPERATOR mode only)
# Password can be changed; during bootstrap default is 'operator-rehearsal-2026'
OPERATOR_PASSWORD_HASH=$2b$10$EP7fR2v6yP/vG5bY06N3iOGo4u2xV1gXWd1fB/rL16GzD45R0oP8e
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
CSRF_SECRET=dev-csrf-secret-change-in-production-min-32-chars

# Internal Lab Controller Secret (for internal management requests)
LAB_CONTROLLER_SECRET=dev-lab-secret-never-expose-to-frontend

# Lab Services Ports
GATEWAY_PORT=8443
ORDERS_PORT=8444
LEDGER_PORT=8445
LAB_CONTROLLER_PORT=8446
ISSUANCE_PROXY_PORT=8447

# Frontend (Vite)
VITE_API_URL=http://localhost:4000
